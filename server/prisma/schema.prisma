generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingActor {
  CUSTOMER
  BUSINESS
}

enum RequestStatus {
  NEW
  REVIEWING
  QUOTE_SENT
  CUSTOMER_RESPONDED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  TIME
  FILE
  LOCATION
  PHONE
  EMAIL
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  CHANGE_REQUESTED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentProvider {
  MANUAL
  CASH
  MOBILE_MONEY
  CARD
}

enum PaymentRecordStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum EventType {
  PAGE_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  DIRECTIONS_CLICK
  ORDER_CLICK
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  QUOTE_REQUEST
  BOOKING_CLICK
  PAYMENT_CLICK
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_CHANGE_REQUESTED
  QUOTE_EXPIRED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  REVIEW_SUBMITTED
}

enum MessageSender {
  CUSTOMER
  BUSINESS
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(BUSINESS_OWNER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  business     Business?
  adminActions AdminAuditLog[] @relation("AdminActor")
}

model Business {
  id                     String                @id @default(uuid())
  ownerId                String                @unique
  name                   String
  slug                   String                @unique
  description            String                @default("")
  tagline                String                @default("")
  highlights             String[]              @default([])
  category               String                @default("Other")
  industryKey            String                @default("other")
  subtype                String                @default("general")
  capabilities           String[]              @default([])
  profileData            Json?
  websiteUrl             String?
  socialLinks            Json?
  preferredLanguage      String                @default("en")
  currency               String                @default("RWF")
  logoUrl                String?
  coverImageUrl          String?
  phone                  String?
  whatsapp               String?
  email                  String?
  address                String?
  city                   String?
  country                String                @default("Rwanda")
  latitude               Float?
  longitude              Float?
  openingHours           Json?
  isPublished            Boolean               @default(false)
  canPublishProducts     Boolean               @default(false)
  productAccessExpiresAt DateTime?
  isBlocked              Boolean               @default(false)
  onboardingStep         Int                   @default(0)
  onboardingCompletedAt  DateTime?
  publishedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  owner                  User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products               Product[]
  services               Service[]
  offers                 Offer[]
  reviews                Review[]
  requestTemplates       RequestTemplate[]
  requests               CustomerRequest[]
  quotes                 Quote[]
  events                 BusinessEvent[]
  adminAuditLogs         AdminAuditLog[]       @relation("BusinessAdminAudit")
  subscriptionPayments   SubscriptionPayment[]
  bookingSettings        BookingSettings?
  availabilityWindows    AvailabilityWindow[]
  availabilityBlocks     AvailabilityBlock[]
  bookings               Booking[]
  orders                 Order[]

  @@index([ownerId])
}

enum SubscriptionPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubscriptionPayment {
  id                   String                    @id @default(uuid())
  businessId           String
  planCode             String
  amount               Decimal                   @db.Decimal(12, 2)
  currency             String                    @default("RWF")
  paymentMethod        String                    @default("MOBILE_MONEY")
  payerPhone           String
  transactionReference String                    @unique
  status               SubscriptionPaymentStatus @default(PENDING)
  submittedAt          DateTime                  @default(now())
  reviewedAt           DateTime?
  reviewNote           String?
  validUntil           DateTime?
  reviewedById         String?
  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([businessId, submittedAt])
}

model BookingSettings {
  id                        String   @id @default(uuid())
  businessId                String   @unique
  isEnabled                 Boolean  @default(false)
  timezone                  String   @default("Africa/Kigali")
  slotIntervalMinutes       Int      @default(30)
  minNoticeMinutes          Int      @default(60)
  maxAdvanceDays            Int      @default(60)
  cancellationCutoffMinutes Int      @default(120)
  requireConfirmation       Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  business                  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AvailabilityWindow {
  id          String   @id @default(uuid())
  businessId  String
  weekday     Int
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday, startMinute, endMinute])
  @@index([businessId, weekday])
}

model AvailabilityBlock {
  id         String   @id @default(uuid())
  businessId String
  serviceId  String?
  startsAt   DateTime
  endsAt     DateTime
  reason     String   @default("")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt, endsAt])
  @@index([serviceId, startsAt, endsAt])
}

model Booking {
  id                    String        @id @default(uuid())
  sequence              Int           @unique @default(autoincrement())
  bookingNumber         String        @unique
  publicToken           String        @unique
  businessId            String
  serviceId             String
  customerName          String
  customerPhone         String?
  customerEmail         String?
  customerNote          String        @default("")
  ownerNote             String        @default("")
  status                BookingStatus @default(PENDING)
  startAt               DateTime
  endAt                 DateTime
  timezone              String        @default("Africa/Kigali")
  durationMinutes       Int
  startingPriceSnapshot Decimal?      @db.Decimal(12, 2)
  currency              String        @default("RWF")
  confirmedAt           DateTime?
  rejectedAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledBy           BookingActor?
  cancellationReason    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service               Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review                Review?

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  @@index([serviceId, startAt, endAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  forAdmins Boolean   @default(false)
  title     String
  message   String
  type      String    @default("INFO")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([forAdmins, readAt, createdAt])
}

model AdminAuditLog {
  id         String    @id @default(uuid())
  actorId    String
  businessId String?
  action     String
  details    Json?
  createdAt  DateTime  @default(now())
  actor      User      @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  business   Business? @relation("BusinessAdminAudit", fields: [businessId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([businessId, createdAt])
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("RWF")
  imageUrl    String?
  category    String   @default("")
  isAvailable Boolean  @default(true)
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([businessId])
}

model Order {
  id                 String             @id @default(uuid())
  sequence           Int                @unique @default(autoincrement())
  orderNumber        String             @unique
  publicToken        String             @unique @default(uuid())
  businessId         String
  customerName       String
  customerPhone      String?
  customerEmail      String?
  customerNote       String             @default("")
  fulfillment        FulfillmentType    @default(PICKUP)
  deliveryAddress    String?
  subtotal           Decimal            @db.Decimal(12, 2)
  total              Decimal            @db.Decimal(12, 2)
  currency           String             @default("RWF")
  status             OrderStatus        @default(PENDING)
  paymentStatus      OrderPaymentStatus @default(UNPAID)
  confirmedAt        DateTime?
  readyAt            DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items              OrderItem[]
  payments           Payment[]

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, paymentStatus])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  productId  String?
  name       String
  imageUrl   String?
  unitPrice  Decimal   @db.Decimal(12, 2)
  quantity   Int
  lineTotal  Decimal   @db.Decimal(14, 2)
  createdAt  DateTime  @default(now())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id           String              @id @default(uuid())
  orderId      String
  provider     PaymentProvider     @default(MANUAL)
  status       PaymentRecordStatus @default(PENDING)
  amount       Decimal             @db.Decimal(12, 2)
  currency     String              @default("RWF")
  reference    String              @unique
  payerPhone   String?
  instructions String              @default("")
  note         String?
  paidAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model Service {
  id                   String              @id @default(uuid())
  businessId           String
  name                 String
  description          String              @default("")
  startingPrice        Decimal             @default(0) @db.Decimal(12, 2)
  currency             String              @default("RWF")
  duration             String?
  durationMinutes      Int?
  bufferMinutes        Int                 @default(0)
  capacity             Int                 @default(1)
  isBookable           Boolean             @default(false)
  imageUrl             String?
  category             String              @default("")
  customRequestEnabled Boolean             @default(true)
  isPublished          Boolean             @default(true)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings             Booking[]
  availabilityBlocks   AvailabilityBlock[]
  reviews              Review[]

  @@index([businessId])
}

model Offer {
  id            String       @id @default(uuid())
  businessId    String
  title         String
  description   String       @default("")
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model RequestTemplate {
  id           String            @id @default(uuid())
  businessId   String
  name         String
  businessType String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  questions    RequestQuestion[]

  @@index([businessId, isActive])
}

model RequestQuestion {
  id         String          @id @default(uuid())
  templateId String
  label      String
  type       QuestionType
  required   Boolean         @default(false)
  options    Json?
  sortOrder  Int             @default(0)
  template   RequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers    RequestAnswer[]

  @@index([templateId, sortOrder])
}

model CustomerRequest {
  id               String          @id @default(uuid())
  sequence         Int             @unique @default(autoincrement())
  requestNumber    String          @unique
  businessId       String
  customerName     String
  customerEmail    String?
  customerPhone    String?
  customerWhatsapp String?
  requestType      String
  description      String          @default("")
  location         String?
  preferredDate    DateTime?
  budget           Decimal?        @db.Decimal(12, 2)
  status           RequestStatus   @default(NEW)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  answers          RequestAnswer[]
  quote            Quote?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model RequestAnswer {
  id         String           @id @default(uuid())
  requestId  String
  questionId String?
  label      String
  value      Json
  request    CustomerRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  question   RequestQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model Quote {
  id                      String          @id @default(uuid())
  sequence                Int             @unique @default(autoincrement())
  quoteNumber             String          @unique
  publicToken             String          @unique @default(uuid())
  requestId               String          @unique
  businessId              String
  subtotal                Decimal         @db.Decimal(12, 2)
  discount                Decimal         @default(0) @db.Decimal(12, 2)
  discountType            DiscountType    @default(FIXED)
  discountValue           Decimal         @default(0) @db.Decimal(12, 2)
  total                   Decimal         @db.Decimal(12, 2)
  currency                String          @default("RWF")
  validityDays            Int             @default(7)
  validUntil              DateTime
  estimatedCompletionDate DateTime?
  paymentTerms            String          @default("")
  depositAmount           Decimal         @default(0) @db.Decimal(12, 2)
  notes                   String          @default("")
  status                  QuoteStatus     @default(DRAFT)
  sentAt                  DateTime?
  viewedAt                DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  request                 CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  business                Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items                   QuoteItem[]
  messages                QuoteMessage[]

  @@index([businessId, status])
  @@index([requestId])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  name        String
  description String  @default("")
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}

model QuoteMessage {
  id         String        @id @default(uuid())
  quoteId    String
  senderType MessageSender
  message    String
  createdAt  DateTime      @default(now())
  quote      Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

model Review {
  id           String   @id @default(uuid())
  businessId   String
  serviceId    String?
  bookingId    String?  @unique
  customerName String
  rating       Int
  comment      String
  isPublished  Boolean  @default(true)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([businessId, isPublished])
  @@index([serviceId])
}

model BusinessEvent {
  id         String    @id @default(uuid())
  businessId String
  eventType  EventType
  metadata   Json?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, eventType])
  @@index([businessId, createdAt])
}
